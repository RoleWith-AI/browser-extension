{
  "manifest_version": 3,
  "name": "RoleWith.AI - CV Generator",
  "version": "1.0.0",
  "description": "Generate tailored CVs from any job posting with one click. AI-powered CV optimization for better interviews.",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Generate CV with RoleWith.AI"
  },

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "minimum_chrome_version": "88",

  "author": "RoleWith.AI",
  "homepage_url": "https://www.rolewith.ai",

  "offline_enabled": false
}
